<vat_common:WindowBase
        x:Class="ProfileEvaluation.MainWindow"
        x:ClassModifier="internal"
        x:TypeArguments="local:ViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProfileEvaluation"
        xmlns:vat_common="clr-namespace:VAT.Common"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:ViewModel}"
        d:Height="900" d:Width="800"
        Title="ProfileEvaluation"
        Height="900" Width="1000"
        MinHeight="900" MinWidth="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrueConverter" />
        <vat_common:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" MinHeight="400"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" MinHeight="400"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" MinHeight="50"/>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" MinHeight="220"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Reference Profile(s)"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="5">
                    <Button x:Name="Button_AddFiles_Left"
                        Content="Add File(s)" Click="Button_AddFiles_Click"
                        Margin="5 0" Padding="3"/>
                    <Button x:Name="Button_ClearFiles_Left"
                            Content="Clear" Click="Button_Clear_Click"
                        Margin="5 0" Padding="3"/>
                </StackPanel>
            </StackPanel>

            <ListView x:Name="ListViewLeft"
                      Grid.Row="1" Grid.Column="0"
                      SelectionMode="Single"
                      ItemsSource="{Binding LeftModel.MCCData}"
                      SelectedItem="{Binding LeftModel.SelectedData.Value}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GetInfoString}"/>
                            <!--<TextBlock Text="{Binding Name}"/>
                            <TextBlock Text=" #"/>
                            <TextBlock Text="{Binding ScanNumber}"/>
                            <TextBlock Text=": "/>
                            <TextBlock Text="{Binding CurveType}" />-->
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="3" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="FieldAnalysisReferenceLeft"
                      Grid.Row="0" Grid.Column="0"
                      MinWidth="50" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Margin="1" Padding="2"
                               FontWeight="Bold"
                               Text="Flatness [%]"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Varian:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding LeftModel.FlatnessVarian.Value}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Elekta:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding LeftModel.FlatnessElekta.Value}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Off-Axis Ratio:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding LeftModel.OffAxisRatio.Value}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Margin="1" Padding="2"
                               FontWeight="Bold"
                               Text="Symmetry [%]"/>
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Varian:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding LeftModel.SymmetryVarian.Value}"/>
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="Elekta:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding LeftModel.SymmetryElekta.Value}"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="0"
                            Orientation="Vertical" VerticalAlignment="Center">
                    <Separator Margin="2" />
                    <CheckBox IsChecked="{Binding LeftModel.CenterField.Value}"
                              Content="Center field"
                              Margin="3 2"/>
                    <Grid Margin="10 0"
                          IsEnabled="{Binding LeftModel.CenterField.Value}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="FW @ [%]:"
                                   Margin="3 0" Padding="2"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding LeftModel.CenterFieldAtFWOf.Value}"
                                 Margin="3 0" Padding="2"
                                 MinWidth="30"
                                 KeyUp="TextBox_KeyUp"/>
                    </Grid>
                    <Separator Margin="2" />
                </StackPanel>
                <oxy:PlotView Grid.RowSpan="2" Grid.Column="1"
                              Model="{Binding LeftModel.PlotModel}"/>
            </Grid>

            <!-- RHS //-->

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                <TextBlock Text="Test Profile(s)"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="5">
                    <Button x:Name="Button_AddFiles_Right"
                        Content="Add File(s)" Click="Button_AddFiles_Click"
                        Margin="5 0" Padding="3"/>
                    <Button x:Name="Button_ClearFiles_Right"
                            Content="Clear" Click="Button_Clear_Click"
                        Margin="5 0" Padding="3"/>
                </StackPanel>
            </StackPanel>

            <ListView x:Name="ListViewRight"
                Grid.Row="1" Grid.Column="1"
                      SelectionMode="Single"
                      ItemsSource="{Binding RightModel.MCCData}"
                      SelectedItem="{Binding RightModel.SelectedData.Value}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GetInfoString}"/>
                            <!--<TextBlock Text="{Binding Name}"/>
                            <TextBlock Text=" #"/>
                            <TextBlock Text="{Binding ScanNumber}"/>
                            <TextBlock Text=": "/>
                            <TextBlock Text="{Binding CurveType}" />-->
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="FieldAnalysisTestRight"
                      Grid.Row="0" Grid.Column="0"
                      MinWidth="50" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Margin="1" Padding="2"
                               FontWeight="Bold"
                               Text="Flatness [%]"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Varian:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding RightModel.FlatnessVarian.Value}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Elekta:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding RightModel.FlatnessElekta.Value}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Off-Axis Ratio:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding RightModel.OffAxisRatio.Value}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Margin="1" Padding="2"
                               FontWeight="Bold"
                               Text="Symmetry [%]"/>
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Margin="1" Padding="2"
                               Text="Varian:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding RightModel.SymmetryVarian.Value}"/>
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="Elekta:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Margin="1" Padding="2"
                             IsEnabled="False"
                             Text="{Binding RightModel.SymmetryElekta.Value}"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="0"
                            Orientation="Vertical" VerticalAlignment="Center">
                    <Separator Margin="2" />
                    <CheckBox IsChecked="{Binding RightModel.CenterField.Value}"
                              Content="Center field"
                              Margin="3 2"/>
                    <Grid Margin="10 0"
                          IsEnabled="{Binding RightModel.CenterField.Value}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="FW @ [%]:"
                                   Margin="3 0" Padding="2"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding RightModel.CenterFieldAtFWOf.Value}"
                                 Margin="3 0" Padding="2"
                                 MinWidth="30"
                                 KeyUp="TextBox_KeyUp"/>
                    </Grid>
                    <Separator Margin="2" />
                </StackPanel>
                <oxy:PlotView Grid.RowSpan="2" Grid.Column="1"
                              Model="{Binding RightModel.PlotModel}"/>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="2" Grid.ColumnSpan="2"
                          IsEnabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Black"
                          Height="2" Margin="5 5"/>
        </Grid>

        <GridSplitter Grid.Row="2" Grid.ColumnSpan="2"
                      IsEnabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Black"
                      Height="2" Margin="5 5"/>
        
        <Grid x:Name="ResultGrid" Grid.Row="3" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0"
                        Orientation="Vertical">
                <Button Content="Compare"
                        Margin="5" Padding="10"
                        Click="Button_Compare_Click"/>

                <Separator Margin="5"/>

                <Grid x:Name="ComparisonSettingsAndResultsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Margin="3" Padding="2"
                               FontWeight="Bold"
                               Text="Settings"/>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="DD [%]:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Margin="3" Padding="2"
                             Text="{Binding GammaDD}"
                             KeyUp="TextBox_KeyUp"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="DTA [mm]:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Margin="3" Padding="2"
                             Text="{Binding GammaDTA}"
                             KeyUp="TextBox_KeyUp"/>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">

                        <StackPanel>
                            <TextBlock Text="Normalize to" Margin="3 0" Padding="0"/>
                            <RadioButton Content="central axis"
                                         IsChecked="{Binding GammaNormalizeCAX}"
                                         Margin="10 0 0 2"/>
                            <RadioButton Content="maximum dose"
                                         IsChecked="{Binding GammaNormalizeMax}"
                                         Margin="10 0 0 2"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding GammaGlobalComparison}"
                                  IsEnabled="True"
                                  Content="Global comparison"
                                  Margin="2"/>

                        <StackPanel Orientation="Vertical"
                            Margin="2">
                            <CheckBox IsChecked="{Binding GammaRestrictToFieldSize}"
                              Content="Restrict to field size"
                              Margin="0 2"/>
                            <Grid Margin="10 0"
                                  IsEnabled="{Binding GammaRestrictToFieldSize}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Field [%]:"
                                           Margin="3 0" Padding="2"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding GammaRestrictToFieldSizePercent}"
                                         Margin="3 0" Padding="2"
                                         KeyUp="TextBox_KeyUp"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Margin="4" Padding="2"
                               FontWeight="Bold"
                               Text="Gamma Result"/>
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="Average-Γ:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Margin="3" Padding="2"
                             IsEnabled="False"
                             Text="{Binding GammaResultAverage}"/>
                    <TextBlock Grid.Row="7" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="Max-Γ:"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Margin="3" Padding="2"
                             IsEnabled="False"
                             Text="{Binding GammaResultMax}"/>
                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Margin="3" Padding="2"
                               Text="f(Γ &lt; 1):"
                               HorizontalAlignment="Right"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Margin="3" Padding="2"
                             IsEnabled="False"
                             Text="{Binding GammaResultFractionLessThanOne}"/>

                </Grid>

                <Separator Margin="5"/>

                <Button Content="Print"
                        Margin="5" Padding="10"
                        IsEnabled="{Binding ComparisonInvalidated.Value, Converter={StaticResource InverseBooleanConverter}, TargetNullValue=false}"
                        Click="Button_Print_Click"/>


            </StackPanel>

            <oxy:PlotView Model="{Binding PlotModel}"
                          Grid.Row="0" Grid.Column="1">
            </oxy:PlotView>
            <Grid Grid.Row="0" Grid.Column="1" Panel.ZIndex="1"
                  Visibility="{Binding ComparisonInvalidated.Value, Converter={StaticResource VisibleIfTrueConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3"
                           Fill="LightGray" Opacity="0.5"
                           Panel.ZIndex="1"/>
                <Border Grid.Row="1" Grid.Column="1"
                        Panel.ZIndex="2"
                        BorderThickness="3" BorderBrush="DarkGray"
                        CornerRadius="5">
                <TextBlock Text="invalid | re-compare"
                           Padding="7"
                           FontSize="32" FontWeight="Bold"
                           Foreground="DarkSlateGray"
                           Background="LightGray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
        
    </Grid>
</vat_common:WindowBase>
